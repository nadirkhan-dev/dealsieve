# Postgres in production (Supabase / Neon). Leave unset to use local SQLite.
DATABASE_URL=
# true = use recorded demo websites, false = crawl live websites
DEMO_MODE=true
# true = on an empty database, import and score the sample leads at startup
# (demo mode only, so it never crawls real sites)
SEED_DEMO=false
# Optional: enables AI-written outreach briefs (template is used otherwise)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
CRAWL_CONCURRENCY=8
CACHE_TTL_HOURS=72
CORS_ORIGINS=http://localhost:5173
